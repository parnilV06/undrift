{
  "name": "undrift-vscode",
  "displayName": "UNDRIFT",
  "description": "Live frontend-backend API contract drift detection inside VS Code.",
  "version": "0.1.0",
  "icon": "resources/undrift-icon.png",
  "publisher": "undrift",
  "engines": {
    "vscode": ">=1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "undrift.scanWorkspace",
        "title": "UNDRIFT: Scan Workspace",
        "category": "UNDRIFT",
        "icon": "$(play)"
      },
      {
        "command": "undrift.showReport",
        "title": "UNDRIFT: Show Integration Report",
        "category": "UNDRIFT",
        "icon": "$(book)"
      },
      {
        "command": "undrift.refresh",
        "title": "UNDRIFT: Refresh Analysis",
        "category": "UNDRIFT",
        "icon": "$(refresh)"
      },
      {
        "command": "undrift.explainFinding",
        "title": "UNDRIFT: Explain Finding",
        "category": "UNDRIFT",
        "icon": "$(info)"
      },
      {
        "command": "undrift.resetHistory",
        "title": "UNDRIFT: Reset Drift History",
        "category": "UNDRIFT",
        "icon": "$(history)"
      },
      {
        "command": "undrift.clearCache",
        "title": "UNDRIFT: Clear In-Memory Workspace State Cache",
        "category": "UNDRIFT",
        "icon": "$(trash)"
      },
      {
        "command": "undrift.openFindingLocation",
        "title": "UNDRIFT: Open Finding Location",
        "category": "UNDRIFT"
      },
      {
        "command": "undrift.applyFix",
        "title": "UNDRIFT: Apply Repair Proposal",
        "category": "UNDRIFT",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "undrift.openFindingLocation",
          "when": "false"
        },
        {
          "command": "undrift.applyFix",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "undrift.scanWorkspace",
          "when": "view == undrift.findingsView || view == undrift.overview",
          "group": "navigation@1"
        },
        {
          "command": "undrift.refresh",
          "when": "view == undrift.findingsView || view == undrift.overview",
          "group": "navigation@2"
        },
        {
          "command": "undrift.showReport",
          "when": "view == undrift.findingsView || view == undrift.overview",
          "group": "navigation@3"
        },
        {
          "command": "undrift.clearCache",
          "when": "view == undrift.findingsView",
          "group": "2_maintenance@1"
        },
        {
          "command": "undrift.resetHistory",
          "when": "view == undrift.findingsView",
          "group": "2_maintenance@2"
        }
      ],
      "view/item/context": [
        {
          "command": "undrift.explainFinding",
          "when": "view == undrift.findingsView && viewItem =~ /^undrift\\.finding/",
          "group": "inline"
        },
        {
          "command": "undrift.showReport",
          "when": "view == undrift.findingsView && viewItem =~ /^undrift\\.finding/",
          "group": "1_actions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "undrift",
          "title": "UNDRIFT",
          "icon": "resources/undrift.svg"
        }
      ]
    },
    "views": {
      "undrift": [
        {
          "type": "webview",
          "id": "undrift.overview",
          "name": "Overview"
        },
        {
          "id": "undrift.findingsView",
          "name": "Findings"
        }
      ]
    },
    "configuration": {
      "title": "UNDRIFT",
      "properties": {
        "undrift.analysis.autoRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run background drift analysis when files are edited, created, or deleted."
        },
        "undrift.analysis.debounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "maximum": 5000,
          "description": "Debounce delay in milliseconds before triggering background analysis following document changes."
        },
        "undrift.analysis.runOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run an initial drift analysis when a workspace is opened."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Extension tests run via root npm test:extension\""
  },
  "dependencies": {
    "@undrift/core": "0.1.0",
    "@undrift/parser-tree-sitter": "0.1.0",
    "@undrift/analyzer-js-ts": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
