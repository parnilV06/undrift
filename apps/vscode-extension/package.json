{
  "name": "undrift-vscode",
  "displayName": "UNDRIFT",
  "description": "Live frontend-backend API contract drift detection inside VS Code.",
  "version": "0.1.0",
  "publisher": "undrift",
  "engines": {
    "vscode": ">=1.100.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "undrift.scanWorkspace",
        "title": "UNDRIFT: Scan Workspace"
      },
      {
        "command": "undrift.showReport",
        "title": "UNDRIFT: Show Integration Report"
      },
      {
        "command": "undrift.refresh",
        "title": "UNDRIFT: Refresh Analysis"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "undrift.findingsView",
          "name": "UNDRIFT Contract Drift"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Extension tests run via root npm test:extension\""
  },
  "dependencies": {
    "@undrift/core": "0.1.0",
    "@undrift/parser-tree-sitter": "0.1.0",
    "@undrift/analyzer-js-ts": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
